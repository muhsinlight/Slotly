#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
head=$(git rev-parse HEAD)
has_updates=false
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    has_updates=true
    if [ "$local_sha" != "$head" ]; then
        echo 'Push blocked: check out the commit being pushed and push it separately.' >&2
        exit 1
    fi
done

if [ "$has_updates" = false ]; then
    exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
    echo 'Push blocked: commit or stash pending changes so checks verify the commit being pushed.' >&2
    exit 1
fi

if [ -f "$root/scripts/check.ps1" ]; then
    if command -v powershell.exe >/dev/null 2>&1; then
        exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check.ps1"
    elif command -v pwsh >/dev/null 2>&1; then
        exec pwsh -NoProfile -File "$root/scripts/check.ps1"
    fi
fi

echo 'Running frontend type-check and production build (local scripts/check.ps1 not present)...'
pnpm --dir "$root/frontend" run build
