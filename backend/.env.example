# Enable the production profile only behind an HTTPS reverse proxy.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/slotly
DATABASE_USERNAME=slotly
DATABASE_PASSWORD=replace-with-a-managed-secret
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=https://app.example.com
BUSINESS_TIME_ZONE=Europe/Istanbul
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
