{
  "info": {
    "name": "Slotly account email",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.collectionVariables.get('username')) pm.collectionVariables.set('username', 'email-' + Date.now());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"EmailTest2026!\",\"firstName\":\"Email\",\"lastName\":\"Test\",\"role\":\"CUSTOMER\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"EmailTest2026!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Add email",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/account/email",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{username}}@example.test\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Resend limit",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/account/email",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{username}}@example.test\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 429', () => pm.response.to.have.status(429));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid verification",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/verify-email",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"token\":\"invalid\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ]
    }
  ]
}
