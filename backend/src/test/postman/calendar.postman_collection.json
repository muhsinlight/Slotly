{
  "info": {
    "name": "Slotly calendar exceptions — isolated local test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only against a disposable Slotly test API. Creates synthetic accounts and appointments. No real customer data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('suffix')) {",
          "  pm.collectionVariables.set('suffix', Date.now().toString(36));",
          "  const date = new Date(Date.now() + 2 * 86400000);",
          "  pm.collectionVariables.set('date', date.toISOString().slice(0, 10));",
          "  pm.collectionVariables.set('day', ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'][date.getUTCDay()]);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Register owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"owner-{{suffix}}\",\n  \"password\": \"PostmanLocalTest2026!\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Test\",\n  \"role\": \"OWNER\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
