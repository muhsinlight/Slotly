    },
    {
      "name": "Create weekly hours",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/owner/places/{{placeId}}/business-hours",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayOfWeek\": \"{{day}}\",\n  \"opensAt\": \"09:00\",\n  \"closesAt\": \"18:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('hourId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create future appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/appointments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"placeId\": \"{{placeId}}\",\n  \"offeringId\": \"{{offeringId}}\",\n  \"startsAt\": \"{{date}}T09:00:00Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('appointmentId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous rejected",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/owner/appointments/{{appointmentId}}/outcome",
        "body": {
          "mode": "raw",
