    {
      "name": "Create place",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/owner/places",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Calendar {{suffix}}\",\n  \"address\": \"Test only\",\n  \"capacity\": 1,\n  \"active\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('placeId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create service",
      "request": {
        "method": "POST",
